# Dependencies
node_modules/

# Build output
dist/
build/
out/

# Electron specific
*.app
*.dmg
*.exe

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment / secrets
.env
.env.local
.env.*.local

# Editor
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# User data (if Electron stores anything locally that shouldn't be tracked)
userData/

# Personal seed / source assets — these dirs only ever held personal-build
# data (Energy Hero brainmap JSON + Miro source SVG/JPG). Both removed in
# the public-ready cleanup; gitignored so future stray personal files
# don't accidentally land in the public repo.
data/
misc/

# Claude Code per-user state (allowed-tools history etc.); keep settings.json tracked
.claude/settings.local.json

# Pre-commit hook marker file — patterns the hook greps against the staged
# diff to prevent personal-data leaks. Gitignored so the markers themselves
# never ship publicly. See .githooks/pre-commit for the hook that reads it.
.pre-commit-personal-markers
